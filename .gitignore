# dependencies and build output
node_modules/
.next/
out/
dist/
*.tsbuildinfo
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# the resolve step's output: regenerated from the installed game, never committed
jobs.json

# secrets and local config
.env
.env.*
!.env.example

# wrangler's local state: the workerd runtime's own scratch, and the per-machine
# secrets file. The inventory proxy has no secrets (ADR-0006) and `.dev.vars` is
# ignored anyway, because "the Worker that has none" is a property worth keeping
# a checkout from quietly losing.
.wrangler/
.dev.vars
.dev.vars.*

# Rendered images and extracted game assets never enter the repo (ADR-0001). `/renders/` is
# the default output root and covers every image the job writes there; point the root
# somewhere else and it is that folder's job to be ignored. Neither `*.png` nor `*.webp` is
# ignored repo-wide: both are formats the site and the docs will legitimately want. The
# manifest under `catalogue/` and its schema are tracked: they are what the site builds
# from.
#
# Anchored, and it has to be: unanchored, `renders/` matches a folder of that name at any
# depth, and `site/src/renders/` — the source that reads the manifest — went silently
# untracked until a review caught it.
/renders/
# The link `site/scripts/link-renders.mjs` makes so a local run is servable in development.
/site/public/renders
# Everything the end-to-end suite builds for itself: the fixture data folder it builds the
# site from, the placeholder images it serves at /renders, and the built site it serves.
/site/.e2e/
# Playwright's own output: the HTML report and a failed run's traces.
/site/playwright-report/
/site/test-results/
assets-cache/
*.mdl
*.vvd
*.vtx
*.vtf
*.vmt
*.blend1

# editor and OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Every change gets its own worktree under here, so each one is a checkout of this
# repository inside itself -- a `git add -A` that catches one commits it as a gitlink
# no clone can resolve. settings.local.json is this machine's permission mode, which
# is nobody else's. The guard itself stays TRACKED: .claude/settings.json,
# .claude/hooks/ and .claude/worktree-per-change.json, because a worktree only gets a
# file if git puts it there.
.claude/worktrees/
.claude/settings.local.json

# `vercel link` writes both: .vercel/ is this machine's link to the deployment, and
# .env.local is the OIDC token it pulls with it. Named rather than a blanket `.env*`,
# because .env.example is tracked on purpose -- it is how the settings are documented.
.vercel/
.env.local
