# Copy to .env and fill in. .env is gitignored; no key ever enters the repository
# or the catalogue file.

# Free Steam Web API key, from https://steamcommunity.com/dev/apikey.
# Names and Backpack Icon URLs come from it.
STEAM_WEB_API_KEY=

# Optional: the "tf" directory of a local TF2 install. When it is set the job
# reads item definitions from it instead of the daily mirror.
TF2_INSTALL_PATH=C:/Program Files (x86)/Steam/steamapps/common/Team Fortress 2/tf
