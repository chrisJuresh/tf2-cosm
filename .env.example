# Copy to .env and fill in. .env is gitignored; no key ever enters the repository
# or the catalogue file.

# Free Steam Web API key, from https://steamcommunity.com/dev/apikey.
# Names and Backpack Icon URLs come from it.
STEAM_WEB_API_KEY=

# Free backpack.tf API key, from https://backpack.tf/developer/apikey/view.
# Every community price and the Key Rate come from it (ADR-0002). Without it the
# job only builds with --skip-prices.
BPTF_API_KEY=

# Optional: the "tf" directory of a local TF2 install. When it is set the job
# reads item definitions from it instead of the daily mirror.
TF2_INSTALL_PATH=C:/Program Files (x86)/Steam/steamapps/common/Team Fortress 2/tf

# Optional: where the site loads Worn Renders from, baked into the build. The
# default serves them from the site itself at /renders, which `pnpm dev` and
# `pnpm build-site` link to the repository's own renders/ folder. Point this at
# a bucket to serve the images from there instead; the manifest does not change,
# because every path in it is relative to this.
NEXT_PUBLIC_RENDER_BASE_URL=

# Optional: where the site reads a viewer's Steam inventory through, baked into
# the build. It is the deployed `worker/` proxy's URL (ADR-0006) — Steam's own
# inventory endpoint sends no CORS headers, so a static page cannot read one
# itself. Unset, the site does not offer the Inventory view at all rather than
# offering it broken, which is the same rule the image base above follows. The
# proxy holds no secret of its own, so there is nothing to put here but a URL.
NEXT_PUBLIC_INVENTORY_API_URL=

# The bucket the Worn Renders are published to, read by `python -m render.publish`.
# Any S3-compatible object store; Cloudflare R2 is what the site is served from
# (docs/render/publishing.md). The secret never leaves this file and the
# environment — it is never logged and never written to the manifest.
RENDER_BUCKET=
RENDER_BUCKET_ENDPOINT=
RENDER_BUCKET_KEY_ID=
RENDER_BUCKET_SECRET=
# Optional: a folder inside the bucket every key goes under, which the image base
# above then has to include as well. Unset means the bucket's root.
RENDER_BUCKET_PREFIX=
