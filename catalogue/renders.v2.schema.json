{
  "$id": "https://github.com/chrisJuresh/tf2-cosm/catalogue/renders/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Which Worn Renders exist and which failed. Keyed by Cosmetic slug, then Class, then Team, then Style index; every path is relative to the configured output root.",
  "properties": {
    "failures": {
      "description": "Why a job produced no image; the site falls back to the Backpack Icon.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "class": {
            "enum": [
              "scout",
              "soldier",
              "pyro",
              "demoman",
              "heavy",
              "engineer",
              "medic",
              "sniper",
              "spy"
            ],
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "failed_at": {
            "type": "string"
          },
          "job_version": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "model-missing",
              "import-error",
              "render-error",
              "no-skeleton",
              "derive-error"
            ],
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "style": {
            "type": "integer"
          },
          "team": {
            "enum": [
              "red",
              "blu"
            ],
            "type": "string"
          }
        },
        "required": [
          "class",
          "detail",
          "failed_at",
          "job_version",
          "model",
          "reason",
          "slug",
          "style",
          "team"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "renders": {
      "additionalProperties": {
        "additionalProperties": {
          "additionalProperties": {
            "additionalProperties": {
              "additionalProperties": false,
              "properties": {
                "derivatives": {
                  "additionalProperties": {
                    "additionalProperties": false,
                    "description": "One image file, by its path relative to the output root.",
                    "properties": {
                      "height": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "path": {
                        "type": "string"
                      },
                      "width": {
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "height",
                      "path",
                      "width"
                    ],
                    "type": "object"
                  },
                  "description": "Web sizes made from the master, keyed by their size in pixels.",
                  "propertyNames": {
                    "pattern": "^[0-9]+$"
                  },
                  "type": "object"
                },
                "job_version": {
                  "type": "integer"
                },
                "master": {
                  "additionalProperties": false,
                  "description": "One image file, by its path relative to the output root.",
                  "properties": {
                    "height": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "path": {
                      "type": "string"
                    },
                    "width": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "height",
                    "path",
                    "width"
                  ],
                  "type": "object"
                },
                "model": {
                  "type": "string"
                },
                "rendered_at": {
                  "type": "string"
                },
                "style_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "team_fallback": {
                  "type": "boolean"
                }
              },
              "required": [
                "derivatives",
                "job_version",
                "master",
                "model",
                "rendered_at",
                "style_name",
                "team_fallback"
              ],
              "type": "object"
            },
            "description": "Renders by Style index.",
            "propertyNames": {
              "pattern": "^[0-9]+$"
            },
            "type": "object"
          },
          "description": "Renders by Team.",
          "propertyNames": {
            "enum": [
              "red",
              "blu"
            ]
          },
          "type": "object"
        },
        "description": "Renders by Class.",
        "propertyNames": {
          "enum": [
            "scout",
            "soldier",
            "pyro",
            "demoman",
            "heavy",
            "engineer",
            "medic",
            "sniper",
            "spy"
          ]
        },
        "type": "object"
      },
      "description": "Renders by Cosmetic slug.",
      "type": "object"
    },
    "version": {
      "const": 2
    }
  },
  "required": [
    "version",
    "renders",
    "failures"
  ],
  "title": "TF2 Cosmetics Worn Render manifest v2",
  "type": "object"
}