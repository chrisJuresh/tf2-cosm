      "required": [
        "snapshotTakenAt",
        "sources",
        "counts",
        "prices",
        "dollarBases"
      ],
      "additionalProperties": false
    },
    "cosmetics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "defindex": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "slot": {
            "type": "string",
            "enum": [
              "head",
              "misc"
            ]
          },
          "classes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "scout",
                "soldier",
                "pyro",
                "demoman",
                "heavy",
                "engineer",
                "medic",
                "sniper",
                "spy"
