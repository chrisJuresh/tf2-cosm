            "withoutWebApiEntry": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "withoutBackpackIcon": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
