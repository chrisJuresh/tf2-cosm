                  "small": {
                    "type": "string",
                    "format": "uri"
                  },
                  "large": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "small",
                  "large"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
