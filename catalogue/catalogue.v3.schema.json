                              "metal": {
                                "type": "object",
                                "properties": {
                                  "scrap": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "refined": {
                                    "type": "number",
                                    "minimum": 0
                                  },
                                  "notation": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "scrap",
                                  "refined",
                                  "notation"
                                ],
                                "additionalProperties": false
                              }
